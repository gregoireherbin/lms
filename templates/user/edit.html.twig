{% extends 'base.html.twig' %}

{% block title %}Modifier l'utilisateur - CyberCamp{% endblock %}

{% block body %}
<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            
            <!-- Carte principale -->
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-body p-4">
                    
                    <!-- En-tête -->
                    <div class="text-center mb-4">
                        <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 70px; height: 70px;">
                            <i class="fa-solid fa-user-pen fa-2x"></i>
                        </div>
                        <h1 class="h3 fw-bold text-dark">Modifier l'utilisateur</h1>
                        <p class="text-muted mb-0">Mettez à jour les informations du membre</p>
                    </div>

                    <hr class="text-muted opacity-25 mb-4">

                    <!-- Inclusion du formulaire Symfony -->
                    {{ include('user/_form.html.twig', {'button_label': 'Mettre à jour'}) }}

                    <!-- Actions (Retour à la liste et Suppression) -->
                    <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                        <a href="{{ path('app_user_index') }}" class="btn btn-outline-secondary">
                            <i class="fa-solid fa-arrow-left me-1"></i> Retour à la liste
                        </a>
                        
                        <div>
                            {{ include('user/_delete_form.html.twig') }}
                        </div>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>
{% endblock %}