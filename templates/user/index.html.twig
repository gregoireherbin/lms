{% extends 'base.html.twig' %}

{% block title %}Liste des utilisateurs - CyberCamp
{% endblock %}

{% block body %}
	<div
		class="container py-4">
		<!-- En-tête -->
		<div class="d-flex justify-content-between align-items-center mb-4">
			<div>
				<h1 class="fw-bold text-dark">
					<i class="fa-solid fa-users text-primary me-2"></i>
					Liste des utilisateurs</h1>
				<p class="text-muted">Gérez les membres inscrits sur la plateforme CyberCamp.</p>
			</div>
			<!-- Si vous avez un bouton pour créer un utilisateur (optionnel) -->
			<!-- <a href="{{ path('app_user_new') }}" class="btn btn-primary"><i class="fa-solid fa-user-plus me-1"></i> Nouvel utilisateur</a> -->
		</div>

		<!-- Tableau stylisé -->
		<div class="card shadow-sm border-0 rounded-3 overflow-hidden">
			<div class="table-responsive">
				<table class="table table-hover align-middle mb-0">
					<thead class="bg-violet">
						<tr>
							<th scope="col" class="py-3 ps-4">Prénom</th>
							<th scope="col" class="py-3">Nom</th>
							<th scope="col" class="py-3">Email</th>
							<th scope="col" class="py-3">Rôles</th>
							<th scope="col" class="py-3 text-end pe-4">Actions</th>
						</tr>
					</thead>
					<tbody>
						{% for user in users %}
							<tr>
								<td class="ps-4 fw-semibold text-dark">{{ user.prenom }}</td>
								<td>{{ user.nom }}</td>
								<td class="text-muted">
									<i class="fa-solid fa-envelope text-secondary me-1"></i>
									{{ user.email }}</td>
								<td>
									{% for role in user.roles %}
										{% if role == 'ROLE_ADMIN' %}
											<span class="badge bg-danger">
												<i class="fa-solid fa-shield-halved me-1"></i>
												Admin</span>
										{% elseif role == 'ROLE_FORMATEUR' %}
											<span class="badge bg-warning text-dark">
												<i class="fa-solid fa-chalkboard-user me-1"></i>
												Formateur</span>
										{% elseif role == 'ROLE_ETUDIANT' %}
											<span class="badge bg-secondary">
												<i class="fa-solid fa-user-graduate me-1"></i>
												Étudiant</span>
										{% endif %}
									{% endfor %}
								</td>
								<td
									class="text-end pe-4">
									<!-- Lien vers la fiche de l'utilisateur (assurez-vous que la route s'appelle bien app_user_show) -->
									<a href="{{ path('app_user_show', {'id': user.id}) }}" class="btn btn-sm btn-outline-primary" title="Voir le profil">
										<i class="fa-solid fa-eye"></i>
										Voir
									</a>
								</td>
							</tr>
						{% else %}
							<tr>
								<td colspan="5" class="text-center py-4 text-muted">
									<i class="fa-solid fa-circle-info me-1"></i>
									Aucun utilisateur trouvé.
								</td>
							</tr>
						{% endfor %}
					</tbody>
				</table>
			</div>
		</div>
	</div>
{% endblock %}
