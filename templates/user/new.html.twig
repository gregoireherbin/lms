{% extends 'base.html.twig' %}

{% block title %}Nouvel Utilisateur - CyberCamp{% endblock %}

{% block body %}
<div class="container my-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <h1 class="h3 mb-4 text-primary">
                        <i class="fa-solid fa-user-plus me-2"></i> Créer un nouvel utilisateur
                    </h1>

                    {{ include('user/_form.html.twig') }}

                    <div class="mt-3">
                        <a href="{{ path('app_user_index') }}" class="text-decoration-none">
                            <i class="fa-solid fa-arrow-left me-1"></i> Retour à la liste
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}