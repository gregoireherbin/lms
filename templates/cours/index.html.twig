{% extends 'base.html.twig' %}

{% block title %}Catalogue des Cours - CyberCamp{% endblock %}

{% block body %}
<div class="container py-4">
    <!-- En-tête de la page -->
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <h1 class="fw-bold text-dark"><i class="fa-solid fa-book-open text-primary me-2"></i> Catalogue des Cours</h1>
            <p class="text-muted">Explorez nos modules et montez en compétences en informatique.</p>
        </div>
        <!-- Si vous avez une route d'ajout de cours pour les admins, vous pouvez l'ajouter ici -->
    </div>

    <!-- Grille des cours -->
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        {% for unCours in cours %}
            <div class="col">
                <div class="card h-100 shadow-sm border-0 rounded-3">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex align-items-center mb-3">
                            <div class="bg-primary bg-opacity-10 p-3 rounded-3 text-primary me-3">
                                <i class="fa-solid fa-code fa-lg"></i>
                            </div>
                            <h3 class="card-title h5 fw-bold mb-0 text-dark">{{ unCours.titre }}</h3>
                        </div>
                        <p class="card-text text-muted flex-grow-1">
                            {{ unCours.description ? unCours.description : "Aucune description disponible pour ce cours." }}
                        </p>
                        <!-- Bouton d'action (adaptez la route selon votre application, ex: app_cours_show) -->
                        <div class="mt-3">
                            <a href="#" class="btn btn-outline-primary w-100">
                                <i class="fa-solid fa-arrow-right me-1"></i> Voir le cours
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="col-12">
                <div class="alert alert-info text-center py-4" role="alert">
                    <i class="fa-solid fa-circle-info fa-2x mb-2"></i>
                    <p class="mb-0">Aucun cours n'est disponible pour le moment. Revenez un peu plus tard !</p>
                </div>
            </div>
        {% endfor %}
    </div>
</div>
{% endblock %}