{% extends 'base.html.twig' %}

{% block title %}Cours : {{ cour.titre }}{% endblock %}

{% block body %}
    <h1>{{ cour.titre }}</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ cour.id }}</td>
            </tr>
            <tr>
                <th>Titre</th>
                <td>{{ cour.titre }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ cour.description }}</td>
            </tr>
        </tbody>
    </table>

    <hr class="my-4">

    <h2>Liste des étapes</h2>
    
    <ul class="list-group mb-4">
        {% for etape in cour.etapes %}
            <li class="list-group-item">
                {# Lien cliquable vers la page de l'étape (vérifie que le nom de la route correspond bien à ton CRUD) #}
                <a href="{{ path('app_etape_show', {'id': etape.id}) }}" class="text-decoration-none">
                    {{ etape.titre }}
                </a>
            </li>
        {% else %}
            <li class="list-group-item text-muted">Aucune étape n'a encore été ajoutée à ce cours.</li>
        {% endfor %}
    </ul>

    <div class="mt-4">
        <a href="{{ path('app_cours_index') }}" class="btn btn-secondary">Back to list</a>
        <a href="{{ path('app_cours_edit', {'id': cour.id}) }}" class="btn btn-primary">Edit</a>
        {{ include('cours/_delete_form.html.twig') }}
    </div>
{% endblock %}