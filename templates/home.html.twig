{% extends 'base.html.twig' %}

{% block title %}Accueil - CyberCamp{% endblock %}

{% block body %}
<!-- Section Hero (En-tête accrocheur) -->
<div class="p-5 mb-4 bg-light rounded-3 shadow-sm border">
    <div class="container-fluid d-flex flex-column align-items-center py-4">
        <h1 class="display-5 fw-bold text-dark">Maîtrisez l'informatique, pas à pas 🚀</h1>
        <p class="col-md-8 fs-4 text-muted">
            Bienvenue sur notre plateforme de cours en ligne dédiée au développement, aux algorithmes et aux bonnes pratiques du code.
        </p>
        {% if not app.user %}
            <div class="mt-4">
                <a class="btn btn-primary btn-lg me-2" href="{{ path('app_login') }}">Commencer dès maintenant</a>
                <a class="btn btn-outline-secondary btn-lg" href="{{ path('app_cours_index') }}">Explorer le catalogue</a>
            </div>
        {% else %}
            <div class="mt-4">
                <a class="btn btn-success btn-lg" href="{{ path('app_etape_index') }}">Accéder à mes cours</a>
            </div>
        {% endif %}
    </div>
</div>

<!-- Section des Fonctionnalités / Avantages -->
<div class="row align-items-md-stretch my-5">
    <div class="col-md-4 mb-4">
        <div class="h-100 p-4 bg-white border rounded-3 shadow-sm">
            <h3><i class="fa-solid fa-laptop-code text-primary me-2"></i> Cours Pratiques</h3>
            <p>Apprenez directement par la pratique avec des exemples de code concrets adaptés à tous les niveaux.</p>
        </div>
    </div>
    <div class="col-md-4 mb-4">
        <div class="h-100 p-4 bg-white border rounded-3 shadow-sm">
            <h3><i class="fa-solid fa-chart-line text-success me-2"></i> Suivi d'Étape</h3>
            <p>Visualisez votre progression étape par étape et validez vos compétences au fur et à mesure.</p>
        </div>
    </div>
    <div class="col-md-4 mb-4">
        <div class="h-100 p-4 bg-white border rounded-3 shadow-sm">
            <h3><i class="fa-solid fa-users text-warning me-2"></i> Communauté</h3>
            <p>Progressez aux côtés d'autres passionnés d'informatique et partagez vos connaissances.</p>
        </div>
    </div>
</div>
{% endblock %}