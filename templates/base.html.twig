<!DOCTYPE html>
<html>
	<head>
		<meta charset="UTF-8">
		<title>
        	{% block title %}Welcome!
			{% endblock %}
		</title>
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"> 
		<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">		
		<link rel="stylesheet" href="{{asset('css/style.css')}}">
                                                                          
        {% block stylesheets %}{% endblock %}{% block javascripts %}
		{% endblock %}
		</head>
		<body>
			<nav class="navbar navbar-expand-lg navbar-dark bg-violet shadow-sm"> <!-- Mode sombre élégant -->
    <div class="container-fluid">
        <!-- 1. Le nom/logo de votre application toujours visible -->
        <a class="navbar-brand fw-bold" href="{{ path('app_home') }}"><i class="fa-solid fa-school"></i>CyberCamp</a>

        <!-- Le bouton Burger pour mobile -->
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <!-- 2. Les liens de navigation -->
        <div class="collapse navbar-collapse" id="navbarNav">
            <!-- Liens principaux à gauche -->
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                <li class="nav-item">
                    <a class="nav-link" href="{{ path('app_cours_index') }}">Cours</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="{{ path('app_etape_index') }}">Etapes</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="{{ path('app_user_index') }}">Utilisateurs</a>
                </li> 
            </ul>

            <!-- Liens d'authentification à droite (`ms-auto`) -->
            <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
                {% if app.user %}
                    <li class="nav-item">
                        <span class="navbar-text text-light me-3">Bonjour, {{ app.user.userIdentifier }}</span>
                    </li>
                    <li class="nav-item">
                        <a class="btn btn-outline-light btn-sm" href="{{ path('app_logout') }}">Se déconnecter</a>
                    </li>
                {% else %}
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_login') }}">Se connecter</a>
                    </li>
                    <li class="nav-item">
                        <a class="btn btn-primary btn-sm ms-2" href="{{ path('app_user_new')}}">S'inscrire</a> <!-- Bouton mis en valeur -->
                    </li>
                {% endif %}
            </ul>
        </div>
    </div>
</nav>
            <div class="container py-5">
            {% block body %}{% endblock %}
            </div>
			
			<script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js" integrity="sha384-I7E8VVD/ismYTF4hNIPjVp/Zjvgyol6VFvRkX/vR+Vc4jQkC+hVqc2pM8ODewa9r" crossorigin="anonymous"></script>
			<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.min.js" integrity="sha384-0pUGZvbkm6XF6gxjEnlmuGrJXVbNuzT9qBBavbLwCsOGabYfZo0T0to5eqruptLy" crossorigin="anonymous"></script>
		</body>
	</html>
